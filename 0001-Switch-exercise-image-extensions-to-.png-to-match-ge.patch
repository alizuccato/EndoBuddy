Subject: [PATCH] Switch exercise image extensions to .png to match generated
 files

---
 public/images/README.md       |  3 +--
 src/data/premium-exercises.js | 26 +++++++++++++-------------
 2 files changed, 14 insertions(+), 15 deletions(-)

diff --git a/public/images/README.md b/public/images/README.md
index 95d962f..671beee 100644
--- a/public/images/README.md
+++ b/public/images/README.md
@@ -4,8 +4,7 @@ Drop your licensed photos here using this naming convention so they wire up
 automatically — no code changes needed:
 
 - Recipes:   /public/images/recipes/<phase>-<slug>.png
-- Exercises: /public/images/exercises/<phase>-<slug>.jpg (or .png — just keep
-  the extension consistent with what src/data/premium-exercises.js expects)
+- Exercises: /public/images/exercises/<phase>-<slug>.png
 
 The exact filenames expected are listed as the `image` field of each entry in:
 - src/data/premium-recipes.js
diff --git a/src/data/premium-exercises.js b/src/data/premium-exercises.js
index fa7993c..5419510 100644
--- a/src/data/premium-exercises.js
+++ b/src/data/premium-exercises.js
@@ -9,7 +9,7 @@
  * IMAGES: `image` is a path under /public that Ali will supply. Until a real file
  * exists at that path, the UI falls back to a themed icon tile (see
  * ImageWithFallback in PremiumExercises.jsx). Suggested convention:
- * /images/exercises/<phase>-<slug>.jpg (e.g. /images/exercises/luteal-yin-yoga.jpg).
+ * /images/exercises/<phase>-<slug>.png (e.g. /images/exercises/luteal-yin-yoga.png).
  *
  * intensity: 'gentle' | 'moderate' | 'active'
  */
